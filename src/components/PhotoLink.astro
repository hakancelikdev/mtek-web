---
// Lightbox'ta açılan fotoğraf. Küçük görsel AVIF/WebP olarak, büyük görsel 1600 px WebP olarak üretilir.
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  group: string;
  sizes: string;
  widths?: number[];
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, group, sizes, widths = [360, 540, 720, 960, 1280], class: className, loading = 'lazy' } = Astro.props;

const full = await getImage({ src, width: Math.min(1600, src.width), format: 'webp', quality: 82 });
---

<a
  href={full.src}
  class:list={['photo-link', className]}
  data-lightbox={group}
  data-caption={alt}
  data-width={full.attributes.width}
  data-height={full.attributes.height}
>
  <Picture src={src} alt={alt} formats={['avif', 'webp']} widths={widths.filter((w) => w <= src.width)} sizes={sizes} loading={loading} decoding="async" />
  <span class="visually-hidden">(büyük görüntüle)</span>
</a>

<style>
  .photo-link {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--mist);
    cursor: zoom-in;
  }
  .photo-link :global(picture) {
    height: 100%;
  }
  .photo-link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
