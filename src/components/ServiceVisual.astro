---
// Faaliyet alanının görseli: gerçek uygulama fotoğrafı varsa o, yoksa sade bir ikon paneli.
// Fotoğrafı olmayan alan için temsili/stok fotoğraf kullanılmaz.
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  service: CollectionEntry<'hizmetler'>;
  sizes: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { service, sizes, loading = 'lazy', class: className } = Astro.props;
const { image, imageAlt, icon } = service.data;
---

<div class:list={['service-visual', className]}>
  {
    image ? (
      <Picture src={image} alt={imageAlt ?? ''} formats={['avif', 'webp']} widths={[400, 640, 960, 1280].filter((w) => w <= image.width)} sizes={sizes} loading={loading} />
    ) : (
      <div class="service-visual__panel" aria-hidden="true">
        <Icon name={icon} size={72} />
      </div>
    )
  }
</div>

<style>
  .service-visual {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--mist);
  }
  .service-visual :global(picture) {
    height: 100%;
  }
  .service-visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .service-visual__panel {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--navy);
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 24px 24px,
      var(--mist);
  }
  .service-visual__panel :global(svg) {
    padding: 1.25rem;
    background: var(--mist);
    box-sizing: content-box;
    stroke-width: 1.25;
  }
</style>
